#!/bin/sh
# Self-service sshid.io key importer -> running user's authorized_keys (deduped).
# Docs: https://ssh.qui.icu
T=/dev/tty; tty_ok() { ( : <$T ) 2>/dev/null; }; ask() { printf '%s' "$1" >$T; read -r R <$T; }
die() { echo "import: $*" >&2; exit 2; }
usage() { cat >&2 <<'U'
usage: curl -fsSL https://ssh.qui.icu/import | sh -s -- [-a] [-t TYPES] [-n NUMS] [-y] [USERNAME]
  -a        import all keys (skip the selection prompt)
  -t TYPES  only these types, comma-separated: ed25519 ecdsa rsa sk sk-ed25519 sk-ecdsa
  -n NUMS   only these key numbers as listed, e.g. 1,3,5
  -y        don't ask for confirmation
U
exit 2; }
SEL=; Y=$SSHID_YES
while getopts at:n:yh o; do case $o in a) SEL=all;; t|n) SEL="$SEL,$OPTARG";; y) Y=1;; *) usage;; esac; done
shift $((OPTIND-1)); U="${1:-$SSHID_USER}"

# 1. Username
[ -z "$U" ] && { tty_ok || die "no terminal: pass a username, e.g. sh -s -- -a qui-le"; ask "sshid.io username: "; U=$R; }
case "$U" in ""|.*|*[!A-Za-z0-9._-]*) die "invalid username '$U'";; esac

# 2. Fetch and list
# sshid.io splits keys by type, so pull every endpoint and dedupe
K=$(for e in "" /ECDSA-SK /ED25519 /ECDSA /RSA; do curl -fsS --max-time 15 "https://sshid.io/$U$e"; echo; done 2>/dev/null \
  | grep -E '^(ssh-|ecdsa-|sk-)' | awk '!s[$2]++'); [ -n "$K" ] || die "no keys found for '$U'"
echo "Keys for $U:"; i=0
echo "$K" | while read -r l; do i=$((i+1))
  f=$(echo "$l" | ssh-keygen -lf - 2>/dev/null) || f=$(echo "$l" | awk '{print $1, $NF}')
  printf '  %2d) %s\n' "$i" "$f"; done

# 3. Choose: all, by number, or by type
pick() { case "$1" in ""|,) echo "$K"; return;; esac
  echo "$K" | awk -v s="$1" 'BEGIN{ n=split(s,a,/[ ,]+/)
      for(i=1;i<=n;i++){ x=a[i]; if(x=="") continue
        if(x=="a"||x=="all") all=1
        else if(x~/^[0-9]+$/) num[x+0]=1
        else if(x~/^(ed25519|ecdsa|rsa|sk|sk-ed25519|sk-ecdsa)$/) typ[x]=1
        else { print "import: unknown key type \"" x "\"" > "/dev/stderr"; bad=1; exit 2 } } }
    { t=$1; m=(all || (NR in num))
      if(("ed25519" in typ) && t=="ssh-ed25519") m=1
      if(("ecdsa" in typ) && t~/^ecdsa-/) m=1
      if(("rsa" in typ) && t=="ssh-rsa") m=1
      if(("sk" in typ) && t~/^sk-/) m=1
      if(("sk-ed25519" in typ) && t~/^sk-ssh-ed25519/) m=1
      if(("sk-ecdsa" in typ) && t~/^sk-ecdsa/) m=1
      if(m) print }'; }
[ -z "$SEL" ] && tty_ok && { ask "Import which? [Enter=all | numbers: 1 3 | types: ed25519,ecdsa,rsa,sk] "; SEL=$R; }
S=$(pick "$SEL") || exit 2; [ -n "$S" ] || die "no keys matched '${SEL#,}'"

# 4. Confirm, then merge + dedupe
H=$(getent passwd "$(id -un)" | cut -d: -f6); AK="$H/.ssh/authorized_keys"; N=$(echo "$S" | grep -c .)
if tty_ok && [ -z "$Y" ]; then ask "Add $N key(s) to $AK (user $(id -un))? [y/N] "; case "$R" in [yY]*) ;; *) echo "aborted, nothing changed"; exit 0;; esac; fi
mkdir -p "$H/.ssh" && chmod 700 "$H/.ssh"; F=$(mktemp)
cp -p "$AK" "$AK.bak" 2>/dev/null; { cat "$AK" 2>/dev/null; echo "$S"; } | awk 'NF && !s[$2]++' > "$F" && cat "$F" > "$AK"; chmod 600 "$AK"; rm -f "$F"
echo "done: $(grep -c . "$AK") keys in $AK (backup: $AK.bak)"
